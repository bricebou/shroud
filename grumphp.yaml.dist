# Checks before each commit: Rector then ECS fix the staged files, PHPStan analyses them, and the
# message must follow the Conventional Commits. The tests are left to the continuous integration.
#
# To run GrumPHP with something else than the PHP of the host, a local `grumphp.yaml`, not versioned,
# imports this file and sets the command of the hooks, then `vendor/bin/grumphp git:init` rewrites them:
#
#   imports:
#     - { resource: grumphp.yaml.dist }
#   grumphp:
#     git_hook_variables:
#       EXEC_GRUMPHP_COMMAND: '<command that runs php in the environment of the project>'

grumphp:
  stop_on_failure: true
  fixer:
    enabled: true
    fix_by_default: true
  tasks:
    rector:
      metadata:
        priority: 20
      triggered_by: [php]
      clear_cache: false
    ecs:
      metadata:
        priority: 10
      files_on_pre_commit: true
      triggered_by: [php]
      no-progress-bar: true
    phpstan:
      metadata:
        priority: 0
      memory_limit: '-1'
      triggered_by: [php]
      use_grumphp_paths: true
    git_commit_message:
      enforce_capitalized_subject: false
      enforce_single_lined_subject: true
      max_subject_width: 80
      # Body lines are not limited: an address may run longer.
      max_body_width: 0
      skip_on_merge_commit: true
      additional_modifiers: u
      type_scope_conventions:
        types: [build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test]
        scopes: []
        subject_pattern: '[\p{L}\p{N}]'
