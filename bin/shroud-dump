#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Writes a pseudonymised SQL dump of a MySQL or MariaDB base; `--help` describes the options.
 */

use Shroud\Adapter\Pdo\MysqlDump;
use Shroud\Cli\Console;
use Shroud\Cli\Database;

// The autoloader of the project that installed the command first, so that its own classes load too.
$autoloads = [__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'];
if (is_string($GLOBALS['_composer_autoload_path'] ?? null)) {
    array_unshift($autoloads, $GLOBALS['_composer_autoload_path']);
}
foreach ($autoloads as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

$connection = Database::USAGE;
$usage = <<<TXT
Writes a pseudonymised SQL dump of a MySQL or MariaDB base.

Usage:
  shroud-dump [--connect[=<file>]] [--host=<host>] [--port=<port>] [--database=<base>]
              [--user=<user>] [--password=<password>] [--dsn=<dsn>]
              [--config=<file>] [--output=<file>] [--dry-run] [--random-salt]

{$connection}

Other options:
  --config    the configuration file of the project, which returns a Configuration object:
              declaration of the tables, salt, language, platform; shroud.php of the current directory by default
  --output    the file to write; the standard output by default
  --dry-run   reads the whole base and passes every row through the strategies without writing
              anything, then reports the refusals by table, column and reason
  --random-salt
              replaces the salt of the project by one drawn at random and kept nowhere: the dump
              cannot be related to the original base, not even by the holder of the project.
              For a base handed to a third party. The ids are still renumbered, consistently.
  -h, --help  this help

The dump imports with mysql into an empty base. Every real password is cleared from it: to log
into the imported site, create an administrator again with the tools of the platform.
Exit code: 0 when the dump is written, or when the dry run passes; 1 when the dry run reports
refusals; 2 on a usage or execution error.

TXT;

$options = getopt('h', [...Database::OPTIONS, 'config::', 'output::', 'dry-run', 'random-salt', 'help']);
if (isset($options['h']) || isset($options['help'])) {
    fwrite(STDOUT, $usage);
    exit(0);
}

Console::run(static function () use ($options, $usage): int {
    $directory = Console::directory();
    $configuration = Console::configuration($options, $directory);
    if (array_key_exists('random-salt', $options)) {
        // Drawn here, used for this run, and forgotten with the process.
        $configuration = $configuration->withSalt(bin2hex(random_bytes(32)));
        fwrite(STDERR, "Random salt: the dump cannot be related to the base, by anyone\n");
    }
    $pdo = Console::connect($options, $configuration, $directory, $usage);
    $dump = new MysqlDump($pdo, $configuration->declaration, $configuration->disguiser());
    $started = microtime(as_float: true);
    $width = max(32, ...array_map(static fn (Shroud\Declaration\Table $table): int => strlen($table->name), $configuration->declaration->tables()));
    $progress = static function (string $table, int $rows) use ($width): void {
        fwrite(STDERR, sprintf("%-{$width}s %9d row%s\n", $table, $rows, $rows === 1 ? '' : 's'));
    };
    $done = static fn (): string => sprintf('Done in %.1f s, peak memory %.1f MiB', microtime(as_float: true) - $started, memory_get_peak_usage(real_usage: true) / 1048576);

    if (array_key_exists('dry-run', $options)) {
        $dryRun = $dump->dryRun($progress);
        fwrite(STDERR, $done() . "\n\n");
        fwrite(STDOUT, implode("\n", $dryRun->report()) . "\n");

        return $dryRun->isClean() ? 0 : 1;
    }

    $file = Console::option($options, 'output');
    $output = $file === null ? STDOUT : fopen($file, 'w');
    if ($output === false) {
        Console::fail('Cannot open the output file ' . $file);
    }
    $dump->write($output, $progress);
    fwrite(STDERR, $done() . "\n");

    return 0;
});
